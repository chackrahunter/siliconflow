{
	"schemaVersion": 1,
	"id": "m3-frametime",
	"version": "${version}",
	"name": "SiliconFlow",
	"description": "SiliconFlow: Apple Silicon frame-time and render optimizations for the exact Minecraft version named by this artifact.",
	"authors": ["Don-Calvin"],
	"contact": {
		"homepage": "https://github.com/chackrahunter/siliconflow",
		"sources": "https://github.com/chackrahunter/siliconflow"
	},
	"license": "MIT",
	"icon": "assets/m3-frametime/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": ["dev.doncalvin.m3frametime.M3FrametimeMod"],
		"client": ["dev.doncalvin.m3frametime.M3FrametimeClient"]
	},
	"mixins": [
		{
			"config": "m3frametime.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": "*",
		"minecraft": "1.21.4",
		"java": ">=21"
	},
	"suggests": {
		"sodium": "*",
		"iris": "*",
		"lithium": "*",
		"ferritecore": "*",
		"immediatelyfast": "*"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.source": "https://github.com/chackrahunter/siliconflow"
			}
		}
	}
}
