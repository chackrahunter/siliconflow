{
	"schemaVersion": 1,
	"id": "m3-frametime",
	"version": "${version}",
	"name": "SiliconFlow",
	"description": "SiliconFlow: Native Mach-Kernel & Metal TBDR Low-Level Optimization Engine for Apple Silicon (M1/M2/M3/M4) on Minecraft 1.21.4.",
	"authors": ["Don-Calvin"],
	"contact": {
		"homepage": "https://github.com/chackrahunter/m3-frametime",
		"sources": "https://github.com/chackrahunter/m3-frametime"
	},
	"license": "MIT",
	"environment": "*",
